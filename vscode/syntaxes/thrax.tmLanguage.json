{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Thrax",
  "scopeName": "source.thrax",
  "fileTypes": ["thx"],
  "patterns": [{ "include": "#item" }, { "include": "#expr" }],
  "repository": {
    "item": {
      "patterns": [
        {
          "match": "^(\\$)\\s*(@mod)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.item.thrax" },
            "2": { "name": "keyword.other.module.thrax" },
            "3": { "name": "entity.name.namespace.thrax" }
          }
        },
        {
          "match": "^(\\$)\\s*(with)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "punctuation.definition.item.thrax" },
            "2": { "name": "keyword.control.import.thrax" },
            "3": { "name": "entity.name.namespace.thrax" }
          }
        },
        {
          "match": "^(\\$)\\s*([A-Z][A-Za-z0-9_]*|@I[A-Z][A-Za-z0-9_]*)\\s*(:)\\s*(@struct|@union|@alias|@effect)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.item.thrax" },
            "2": { "name": "entity.name.type.thrax" },
            "3": { "name": "punctuation.separator.type.thrax" },
            "4": { "name": "storage.type.thrax" }
          }
        },
        {
          "match": "^(\\$)\\s*([a-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.item.thrax" },
            "2": { "name": "entity.name.function.thrax" }
          }
        },
        {
          "match": "^(\\$)\\s*(\\()([!$%&*+\\-/:;<=>^|~]+)(\\))",
          "captures": {
            "1": { "name": "punctuation.definition.item.thrax" },
            "3": { "name": "entity.name.function.operator.thrax" }
          }
        },
        {
          "match": "^(\\$)\\s*(@main|@build|@e|@run|@private)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.item.thrax" },
            "2": { "name": "keyword.other.directive.thrax" }
          }
        }
      ]
    },
    "expr": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#at" },
        { "include": "#keyword" },
        {
          "match": "\\?\\?\\?",
          "name": "invalid.deprecated.hole.thrax"
        },
        {
          "match": "(\\.)\\s*([a-z_][A-Za-z0-9_]*)\\s*(?==[^=>])",
          "captures": {
            "1": { "name": "punctuation.accessor.thrax" },
            "2": { "name": "variable.other.property.thrax" }
          }
        },
        {
          "match": "(?<=\\.)[a-z_][A-Za-z0-9_]*",
          "name": "variable.other.property.thrax"
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(:)(?![:=])",
          "captures": {
            "1": { "name": "variable.other.property.thrax" }
          }
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.thrax"
        },
        {
          "match": "\\\\",
          "name": "storage.type.function.lambda.thrax"
        },
        {
          "match": "=>|->",
          "name": "keyword.operator.arrow.thrax"
        },
        {
          "match": "[!$%&*+\\-/:;<=>^|~]+",
          "name": "keyword.operator.thrax"
        },
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.range.thrax"
        },
        {
          "match": "[,.]",
          "name": "punctuation.separator.thrax"
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [{ "include": "#expr" }]
        }
      ]
    },
    "comment": {
      "patterns": [
        { "include": "#block-comment" },
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.thrax"
        }
      ]
    },
    "block-comment": {
      "begin": "#-",
      "end": "-#",
      "name": "comment.block.thrax",
      "patterns": [{ "include": "#block-comment" }]
    },
    "string": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.thrax",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.thrax"
        },
        {
          "begin": "\\?\\(",
          "end": "\\)",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.thrax" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.thrax" } },
          "contentName": "meta.embedded.line.thrax",
          "name": "meta.interpolation.thrax",
          "patterns": [{ "include": "#expr" }]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9a-fA-F_]+\\b|\\b0[bB][01_]+\\b",
          "name": "constant.numeric.integer.thrax"
        },
        {
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?i\\b",
          "name": "constant.numeric.imaginary.thrax"
        },
        {
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9]+\\b",
          "name": "constant.numeric.float.thrax"
        },
        {
          "match": "\\b[0-9][0-9_]*\\b",
          "name": "constant.numeric.integer.thrax"
        }
      ]
    },
    "at": {
      "patterns": [
        {
          "match": "@(true|false)\\b",
          "name": "constant.language.boolean.thrax"
        },
        {
          "match": "@(int|nat|int8|int16|int32|int64|nat8|nat16|nat32|nat64|float32|float64|str|ptr|bool|array|vec|token|code|future|chan|tvar)\\b",
          "name": "support.type.builtin.thrax"
        },
        {
          "match": "@(io|meta)\\b",
          "name": "support.type.effect.thrax"
        },
        {
          "match": "@I[A-Z][A-Za-z0-9_]*\\b",
          "name": "support.type.interface.thrax"
        },
        {
          "match": "@(mod|struct|union|alias|effect)\\b",
          "name": "storage.type.thrax"
        },
        {
          "match": "@(main|build|e|run|ctx|private|extern)\\b",
          "name": "keyword.other.directive.thrax"
        },
        {
          "match": "@[A-Za-z][A-Za-z0-9_]*\\b",
          "name": "support.function.builtin.thrax"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(if|else|is)\\b",
          "name": "keyword.control.conditional.thrax"
        },
        {
          "match": "\\b(let|in|with|do|ctl|defer)\\b",
          "name": "keyword.control.thrax"
        }
      ]
    }
  }
}
