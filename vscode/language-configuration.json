{
  "comments": {
    "lineComment": "#",
    "blockComment": [
      "#-",
      "-#"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "#-",
      "close": " -#",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "wordPattern": "@?[A-Za-z_][A-Za-z0-9_]*|\\?\\?\\?",
  "folding": {
    "markers": {
      "start": "^\\s*#-",
      "end": "-#\\s*$"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "(=|=>|\\bin|[{\\[(])\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*[}\\])]"
  }
}
